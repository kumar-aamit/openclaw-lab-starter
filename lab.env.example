# Copy to lab.env (git-ignored). make dev and make wait read it.
LAB_USER=user-7
GITEA_REMOTE=https://gitea.example.com/admin/user-7.git
APP_URL=https://user-7-rtp0000000.apps.example.com
INSECURE_TLS=1

# Model endpoints as this machine reaches them
LLM_FAST_URL=http://vllm-fast.example.com/v1
LLM_FAST_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_SMART_URL=http://nemotron-super.example.com/v1
LLM_SMART_MODEL=nvidia/nemotron-3.5-super
# Shown on the status page and screen chips; set to how each model is actually served
LLM_FAST_PRECISION=FP8
LLM_SMART_PRECISION=NVFP4
# How answers are asked for: schema (response_format json_schema), object (json_object, schema in
# the prompt) or prompt (schema in the prompt only). Use object or prompt where json_schema fails.
LLM_FAST_JSON=schema
LLM_SMART_JSON=schema
LLM_API_KEY=
LLM_MOCK=0
SITE_NAME="dCloud lab"
